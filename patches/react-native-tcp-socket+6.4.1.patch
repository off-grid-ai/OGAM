+    @Override
+    public void invalidate() {
+        // Android keeps the process alive across a React Native reload. Release native listeners
+        // that the old JS runtime can no longer close, or the new runtime cannot bind the port.
+        executorService.shutdownNow();
+        for (TcpSocket socket : socketMap.values()) {
+            if (socket instanceof TcpSocketServer) {
+                ((TcpSocketServer) socket).close();
+            } else if (socket instanceof TcpSocketClient) {
+                ((TcpSocketClient) socket).destroy();
+            }
+        }
+        socketMap.clear();
+        pendingTLS.clear();
+        super.invalidate();
+    }

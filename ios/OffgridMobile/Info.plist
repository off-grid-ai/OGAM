<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(INFOPLIST_KEY_CFBundleDisplayName)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ai.offgridmobile.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>offgrid</string>
			</array>
		</dict>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>twitter</string>
		<string>x</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>100.64.0.0/10</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_ollama._tcp</string>
		<string>_lmstudio._tcp</string>
		<string>_offgrid._tcp</string>
		<string>_offgrid-sync._tcp</string>
		<string>_offgrid-sync._udp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Off Grid AI uses the camera when you take a photo to attach to a conversation or to turn into a video, and when you scan a pairing code to connect your computer.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Off Grid AI uses Face ID to unlock the API keys and licence it keeps for you in this phone’s keychain.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Off Grid AI uses your local network to find Off Grid AI Desktop and other AI servers on your Wi‑Fi, and to send your requests to them.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Off Grid AI uses the microphone when you dictate a message, record a voice note, or talk to the assistant hands-free. Your speech is turned into text on this phone.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Off Grid AI saves the images and videos it makes to your photo library when you choose to save or share them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Off Grid AI opens your photo library when you choose a photo to attach to a conversation, to animate into a video, or to keep a character looking the same in every shot. If you turn on screenshot sharing, it also watches for new screenshots to send to your paired devices.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Off Grid AI reads and creates calendar events only when you ask it to in a conversation.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Off Grid AI reads and creates calendar events only when you ask it to in a conversation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Off Grid AI can use this phone’s own speech recognition to turn what you say into text.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>Feather.ttf</string>
		<string>MaterialIcons.ttf</string>
		<string>MaterialCommunityIcons.ttf</string>
		<string>Fontisto.ttf</string>
		<string>Octicons.ttf</string>
		<string>FontAwesome6_Regular.ttf</string>
		<string>Entypo.ttf</string>
		<string>FontAwesome5_Brands.ttf</string>
		<string>AntDesign.ttf</string>
		<string>Foundation.ttf</string>
		<string>Ionicons.ttf</string>
		<string>FontAwesome5_Solid.ttf</string>
		<string>FontAwesome5_Regular.ttf</string>
		<string>FontAwesome.ttf</string>
		<string>Zocial.ttf</string>
		<string>EvilIcons.ttf</string>
		<string>FontAwesome6_Solid.ttf</string>
		<string>SimpleLineIcons.ttf</string>
		<string>FontAwesome6_Brands.ttf</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- `audio` is here for Picture in Picture, which Apple requires it for: a video
	     attachment is played with playInBackground / enterPictureInPictureOnLeave, so it
	     keeps playing in the PiP window after the app leaves the foreground. It was removed
	     once (Feb 2026, Guideline 2.5.4) when nothing played in the background; PiP arrived
	     afterwards. Remove it again only if PiP and background playback go. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).video.*</string>
	</array>
</dict>
</plist>

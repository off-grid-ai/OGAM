diff --git a/src/core/util.cpp b/src/core/util.cpp
index a691b42..8c5aead 100644
--- a/src/core/util.cpp
+++ b/src/core/util.cpp
@@ -373,6 +373,46 @@ int32_t sd_get_num_physical_cores() {
     return n_threads > 0 ? (n_threads <= 4 ? n_threads : n_threads / 2) : 4;
 }
 
+static sd_video_decode_progress_cb_t sd_decode_progress_cb = nullptr;
+static sd_video_decoded_frame_cb_t sd_decoded_frame_cb = nullptr;
+static void* sd_decode_cb_data = nullptr;
+static thread_local bool sd_video_decode_active = false;
+static thread_local int sd_decode_spatial_completed = 0;
+static thread_local int sd_decode_spatial_total = 0;
+static thread_local int sd_decode_temporal_total = 1;
+
+SDVideoDecodeScope::SDVideoDecodeScope() : previous(sd_video_decode_active) {
+    sd_video_decode_active = true;
+    sd_video_decode_progress(0, 0);
+}
+SDVideoDecodeScope::~SDVideoDecodeScope() { sd_video_decode_active = previous; }
+void sd_video_decode_progress(int completed, int total) {
+    if (!sd_video_decode_active) return;
+    // A fresh spatial pass also resets the multiplier on an allocation retry.
+    if (completed == 0) sd_decode_temporal_total = 1;
+    sd_decode_spatial_completed = completed;
+    sd_decode_spatial_total = total;
+    if (sd_decode_progress_cb)
+        sd_decode_progress_cb(completed * sd_decode_temporal_total,
+                              total * sd_decode_temporal_total, sd_decode_cb_data);
+}
+void sd_video_decode_temporal_progress(int completed, int total) {
+    if (!sd_video_decode_active || total <= 0) return;
+    sd_decode_temporal_total = total;
+    if (sd_decode_progress_cb)
+        sd_decode_progress_cb(sd_decode_spatial_completed * total + completed,
+                              std::max(1, sd_decode_spatial_total) * total, sd_decode_cb_data);
+}
+void sd_video_decoded_frame(const sd_image_t* frame) {
+    if (frame && frame->data && sd_decoded_frame_cb)
+        sd_decoded_frame_cb(frame, sd_decode_cb_data);
+}
+void sd_set_video_decode_callback(sd_video_decode_progress_cb_t progress, sd_video_decoded_frame_cb_t frame, void* data) {
+    sd_decode_progress_cb = progress;
+    sd_decoded_frame_cb = frame;
+    sd_decode_cb_data = data;
+}
+
 static sd_progress_cb_t sd_progress_cb = nullptr;
 void* sd_progress_cb_data              = nullptr;
 

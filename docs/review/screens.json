    "versions": [
      {
        "v": 1,
        "label": "New: low-memory mode",
        "at": "2026-11-10T05:47:00Z",
        "file": "screens/v/chat-low-memory-ios-1.jpg",
        "android": "screens/v/chat-low-memory-android-1.jpg",
        "what": "LFM2.5 8B (4.8 GB) on an 11 GB Android with 5.1 GB free: a copy needed 6.8 GB, so it loaded mapped in 10 s and answered at 4.4 tok/s. Gemma 4 E2B on the same phone still loads as a full-speed copy (5.0 tok/s). iPhone: K2 Horizon 3.7B on a 12 GB iPhone loads as before (weights were already mapped), no notice, answered in 5.5 s.",
        "androidClip": "screens/v/chat-low-memory-android-1.mp4"
      },
      {
        "v": 2,
        "label": "K2 thinking tags hidden",

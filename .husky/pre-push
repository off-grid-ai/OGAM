#!/usr/bin/env sh

ZERO_OID="0000000000000000000000000000000000000000"

collect_changed_files() {
  changed_files=""

  if [ -t 0 ]; then
    git diff --name-only --diff-filter=ACMR @{upstream}..HEAD 2>/dev/null || true
    return
  fi

  while read -r local_ref local_oid remote_ref remote_oid; do
    [ -z "$local_oid" ] && continue
    [ "$local_oid" = "$ZERO_OID" ] && continue

    if [ "$remote_oid" = "$ZERO_OID" ]; then
      # New feature branches in this fork are commonly based on atlas-voice, not main.
      # Prefer atlas-voice only when it is actually an ancestor of the pushed commit.
      if git rev-parse --verify origin/atlas-voice >/dev/null 2>&1 && git merge-base --is-ancestor origin/atlas-voice "$local_oid" 2>/dev/null; then
        base=$(git merge-base "$local_oid" origin/atlas-voice 2>/dev/null || true)
      else
        base=$(git merge-base "$local_oid" origin/main 2>/dev/null || true)
      fi
      if [ -n "$base" ]; then
        range="$base..$local_oid"
        changed=$(git diff --name-only --diff-filter=ACMR "$range")
      else
        changed=$(git diff-tree --no-commit-id --name-only -r --diff-filter=ACMR "$local_oid")
      fi
    else
      range="$remote_oid..$local_oid"
      changed=$(git diff --name-only --diff-filter=ACMR "$range")
    fi

    changed_files="${changed_files}
${changed}"
  done

  printf '%s\n' "$changed_files" | sed '/^$/d' | sort -u
}

CHANGED_FILES=$(collect_changed_files)

PUSHED_JS=$(printf '%s\n' "$CHANGED_FILES" | grep -E '\.(ts|tsx|js|jsx)$' || true)
PUSHED_SWIFT=$(printf '%s\n' "$CHANGED_FILES" | grep '\.swift$' | grep -v 'Pods/' | grep -v 'build/' || true)
PUSHED_KOTLIN=$(printf '%s\n' "$CHANGED_FILES" | grep -E '\.(kt|kts)$' || true)

if [ -n "$PUSHED_JS" ]; then
  echo "▶ JS/TS lint (push range)..."
  echo "$PUSHED_JS" | tr '\n' '\0' | xargs -0 eslint --max-warnings=999

  echo "▶ TypeScript type check..."
  npx tsc --noEmit

  PUSHED_TESTS=$(printf '%s\n' "$PUSHED_JS" | grep -E '^__tests__/.*\.(test|spec)\.(ts|tsx|js|jsx)$' || true)
  if [ -n "$PUSHED_TESTS" ]; then
    echo "▶ Directly changed JS/TS tests (hard gate)..."
    echo "$PUSHED_TESTS" | tr '\n' '\0' | xargs -0 npx jest --runInBand --passWithNoTests --runTestsByPath
  fi

  echo "▶ JS/TS related-test regression check..."
  related_log=$(mktemp)
  set +e
  echo "$PUSHED_JS" | tr '\n' '\0' | xargs -0 npx jest --findRelatedTests --passWithNoTests --runInBand >"$related_log" 2>&1
  related_status=$?
  set -e
  cat "$related_log"
  if [ "$related_status" -ne 0 ]; then
    failed_suites=$(sed -n 's/^Test Suites: \([0-9][0-9]*\) failed.*/\1/p' "$related_log" | tail -1)
    failed_tests=$(sed -n 's/^Tests: *\([0-9][0-9]*\) failed.*/\1/p' "$related_log" | tail -1)
    # atlas-voice currently carries 38 failing related suites / 144 failed tests
    # (including intentional red-flow reproductions). Do not make that debt worse.
    if [ -z "$failed_suites" ] || [ "$failed_suites" -gt 38 ] || [ -z "$failed_tests" ] || [ "$failed_tests" -gt 144 ]; then
      echo "❌ Related tests regressed beyond atlas-voice baseline (38 suites / 144 tests)." >&2
      rm -f "$related_log"
      exit 1
    fi
    echo "⚠️  Related tests are within the known atlas-voice baseline: ${failed_suites} suites / ${failed_tests} tests."
  fi
  rm -f "$related_log"

  echo "▶ Architecture gate (dependency-cruiser, baseline-aware)..."
  dep_log=$(mktemp)
  set +e
  npm run depcruise >"$dep_log" 2>&1
  dep_status=$?
  set -e
  cat "$dep_log"
  if [ "$dep_status" -ne 0 ]; then
    dep_count=$(sed -n 's/^x \([0-9][0-9]*\) dependency violations.*/\1/p' "$dep_log" | tail -1)
    if [ -z "$dep_count" ] || [ "$dep_count" -gt 33 ]; then
      echo "❌ Dependency violations regressed beyond atlas-voice baseline (33)." >&2
      rm -f "$dep_log"
      exit 1
    fi
    echo "⚠️  Dependency violations match/improve the known atlas-voice baseline: ${dep_count}/33."
  fi
  rm -f "$dep_log"

  # knip has pre-existing dead-code findings. Still run and report it locally; CI remains
  # authoritative until that baseline is cleaned up.
  echo "▶ Dead-code scan (knip, informational baseline)..."
  npm run knip || echo "⚠️  knip reported the known public-fork baseline findings; see output above."
fi

if [ -n "$PUSHED_SWIFT" ]; then
  if command -v swiftlint >/dev/null 2>&1; then
    echo "▶ SwiftLint (push range)..."
    echo "$PUSHED_SWIFT" | tr '\n' '\0' | xargs -0 swiftlint lint --quiet
  else
    echo "⚠️  SwiftLint not installed — skipping Swift lint. Install: brew install swiftlint"
  fi

  if command -v xcodebuild >/dev/null 2>&1; then
    echo "▶ iOS tests..."
    npm run test:ios
  else
    echo "⚠️  Xcode not available on this machine — skipping iOS tests (CI/macOS must run them)."
  fi
fi

if [ -n "$PUSHED_KOTLIN" ]; then
  ANDROID_SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
  if [ -f "android/local.properties" ] || { [ -n "$ANDROID_SDK" ] && [ -d "$ANDROID_SDK/platforms" ] && [ -d "$ANDROID_SDK/build-tools" ]; }; then
    echo "▶ Kotlin type check (compileDebugKotlin)..."
    (cd android && ./gradlew compileDebugKotlin --quiet)

    echo "▶ Android lint..."
    (cd android && ./gradlew :app:lintDebug --quiet)

    echo "▶ Android tests..."
    npm run test:android
  else
    echo "⚠️  Android SDK is incomplete/unavailable on this machine — skipping native Android checks. GitHub Actions remains authoritative."
  fi
fi

if [ -n "$PUSHED_JS$PUSHED_SWIFT$PUSHED_KOTLIN" ]; then
  echo "▶ Sonar scan..."
  npm run sonar
fi

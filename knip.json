{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "App.tsx",
    "__tests__/**/*.{ts,tsx}",
    "pro/**/*.{ts,tsx}",
    "scripts/lib/engines.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "pro/**/*.{ts,tsx}"
  ],
  "ignoreBinaries": [
    "swiftlint"
  ],
  "ignoreDependencies": [
    "@offgrid/pro",
    "buffer",
    "js-sha512",
    "tweetnacl",
    "tweetnacl-util",
    "react-compiler-runtime",
    "eslint-plugin-react-compiler",
    "eslint-plugin-react-native",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks",
    "@babel/preset-env",
    "@babel/runtime",
    "sonar-scanner",
    "babel-plugin-istanbul"
  ]
}

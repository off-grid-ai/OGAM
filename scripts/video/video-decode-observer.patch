 static float passed_time = 0.f;
 
 void pretty_progress(int step, int steps, float time) {
+    // Video decode has its own section callback; keep it out of sampling progress.
+    if (sd_video_decode_active && sd_decode_progress_cb) return;
     if (sd_progress_cb) {
         sd_progress_cb(step, steps, time, sd_progress_cb_data);
         return;
@@ -624,6 +666,8 @@ void pretty_progress(int step, int steps, float time) {
 }
 
 void pretty_bytes_progress(int step, int steps, uint64_t bytes_processed, float elapsed_seconds) {
+    // Loading counts are not sampling steps, even when their totals happen to match.
+    if (sd_decode_progress_cb) return;
     if (sd_progress_cb) {
         float time = elapsed_seconds / (step + 1e-6f);
         sd_progress_cb(step, steps, time, sd_progress_cb_data);

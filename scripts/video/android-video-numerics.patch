+#if defined(__ANDROID__)
+    // These tensors are already in host memory. Scan once without copying them.
+    static void log_video_tensor_summary(const char* stage, const sd::Tensor<float>& tensor) {
+        int64_t finite = 0;
+        int64_t zero = 0;
+        double minimum = INFINITY;
+        double maximum = -INFINITY;
+        double sum = 0;
+        double squares = 0;
+        for (const float value : tensor.values()) {
+            if (!std::isfinite(value)) continue;
+            ++finite;
+            if (value == 0.0f) ++zero;
+            minimum = std::min(minimum, static_cast<double>(value));
+            maximum = std::max(maximum, static_cast<double>(value));
+            sum += value;
+            squares += static_cast<double>(value) * value;
+        }
+        LOG_INFO("OFFGRID_VIDEO_NUMERICS stage=%s values=%lld finite=%lld nonfinite=%lld zero=%lld min=%.9g max=%.9g mean=%.9g rms=%.9g",
+                 stage, (long long)tensor.numel(), (long long)finite,
+                 (long long)(tensor.numel() - finite), (long long)zero,
+                 minimum, maximum, finite ? sum / finite : 0.0,
+                 finite ? std::sqrt(squares / finite) : 0.0);
+    }
+#endif
